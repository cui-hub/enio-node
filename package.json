{
  "name": "enio-node",
  "version": "0.1.0",
  "private": true,
  "description": "A small, documented agent runtime with sub-agent delegation inspired by Eino",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "ENIO_LIVE_TEST=1 vitest run tests/live.test.ts",
    "demo": "tsx examples/file-report.ts",
    "demo:business": "tsx examples/business-tool.ts",
    "demo:instructions": "tsx examples/project-instructions.ts",
    "demo:context": "tsx examples/context-resume.ts",
    "demo:live": "tsx examples/file-report.ts --live",
    "check": "corepack pnpm run format:check && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run build",
    "demo:v3": "tsx examples/single-agent-v3.ts",
    "demo:v4": "tsx examples/subagents-v4.ts",
    "demo:roles": "tsx examples/agent-roles.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "openai": "7.34.0",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/picomatch": "4.0.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
